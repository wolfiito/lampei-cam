{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/ws",
      "destination": "/api/ws"
    },
    {
      "source": "/sender",
      "destination": "/index.html"
    },
    {
      "source": "/receiver",
      "destination": "/index.html"
    }
  ]
}

